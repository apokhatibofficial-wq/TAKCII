{
  "name": "tak-c-taxi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:rider": "npm run dev -w apps/rider",
    "build:rider": "npm run build -w apps/rider",
    "typecheck:rider": "npm run typecheck -w apps/rider",
    "dev:admin": "npm run dev -w apps/admin",
    "build:admin": "npm run build -w apps/admin",
    "typecheck:admin": "npm run typecheck -w apps/admin",
    "typecheck:driver": "npm run typecheck -w apps/driver",
    "test:critical-path": "vitest run tests/critical-path.test.ts"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "^5.4.10"
  }
}
