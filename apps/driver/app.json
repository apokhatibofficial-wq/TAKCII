{
  "expo": {
    "name": "TAK-C.TAXI — سائق",
    "slug": "takc-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "takcdriver",
    "android": {
      "package": "taxi.takc.driver",
      "adaptiveIcon": {
        "backgroundColor": "#fde403",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج TAK-C.TAXI موقعك ليصلك طلبات الركوب القريبة، ولإرسال موقعك للركاب أثناء الرحلة — حتى عندما تكون الشاشة مغلقة.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-audio",
      "./plugins/withReleaseSigning.js",
      "@sentry/react-native",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications"
    ]
  }
}
